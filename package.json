{
  "name": "mesura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "tsx scripts/generate-assets.ts",
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "prebuild": "tsx scripts/generate-assets.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --project=mobile-390 && playwright test --project=mobile-360",
    "test:pages": "tsx scripts/smoke-pages.ts && tsx scripts/smoke-auth-callback.ts",
    "check:cloud": "deno check --config supabase/functions/deno.json supabase/functions/mesura-api/index.ts",
    "bundle:cloud": "tsx scripts/bundle-cloud.ts",
    "check": "npm run build && npm test",
    "push:keys": "web-push generate-vapid-keys",
    "format": "prettier --write src server shared scripts tests *.ts *.json *.html docs README.md"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@supabase/supabase-js": "2.117.2",
    "archiver": "8.0.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.5",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "luxon": "3.7.2",
    "nodemailer": "10.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "deno": "2.9.6",
    "imagescript": "1.3.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
