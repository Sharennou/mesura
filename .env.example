# Origine publique unique : même domaine pour l'interface et /api.
APP_URL=http://localhost:5173
PORT=3001
HOST=127.0.0.1
# Adresses des proxys de confiance seulement, jamais « true ».
TRUST_PROXY=
DATA_DIR=./data
# Volume indépendant des sauvegardes SQLite en production.
DELETION_LEDGER=
# Obligatoire en production. openssl rand -base64 48
BETTER_AUTH_SECRET=
# SMTP nécessaire pour vérification et récupération en production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Mesura <contact@example.com>
# npm run push:keys ; secrets exclusivement serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Coordonnées du responsable à compléter avant publication.
PRIVACY_CONTACT=
